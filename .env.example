NODE_ENV=development
PORT=3000

APP_NAME=tobiira-api
API_PREFIX=api/v1

MONGODB_URI=mongodb://localhost:27017/tobiira
MONGODB_URI_CORE=mongodb://localhost:27017/T1-D-CORE
MONGODB_URI_PERSTA=mongodb://localhost:27017/T1-D-PERSTA
MONGODB_URI_TESTA=mongodb://localhost:27017/T1-D-TESTA

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Preferred names (used by auth module; falls back to JWT_SECRET/JWT_EXPIRES_IN)
JWT_ACCESS_SECRET=change_me_access
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

OTP_TTL_MINUTES=10
OTP_LENGTH=6

# Brevo (Email)
BREVO_API_KEY=change-me
BREVO_SENDER_EMAIL=sender@example.com
BREVO_SENDER_NAME=Tobiira

# Sessions (legacy - no longer used once JWT refresh is enabled)
SESSION_TTL_DAYS=7
