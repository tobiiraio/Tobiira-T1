NODE_ENV=development

# ── Service port (set per service when running individually) ─────────────────
# Platform (60xx)
# PORT=6000  core
# PORT=6001  notifications
# PORT=6002  documents
# PORT=6003  payments
#
# Verticals (70xx)
# PORT=7000  persta
# PORT=7001  testa
# PORT=7002  lumi
# PORT=7003  costa
PORT=6000

APP_NAME=Tobiira
APP_PUBLIC_URL=https://id.tobiira.io

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI_CORE=mongodb+srv://<user>:<pass>@<cluster>/T1-D-CORE?retryWrites=true&w=majority
MONGODB_URI_PERSTA=mongodb+srv://<user>:<pass>@<cluster>/T1-D-PERSTA?retryWrites=true&w=majority
MONGODB_URI_PAYMENTS=mongodb+srv://<user>:<pass>@<cluster>/T1-D-PAYMENTS?retryWrites=true&w=majority
MONGODB_URI_TESTA=mongodb+srv://<user>:<pass>@<cluster>/T1-D-TESTA?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=30d

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=10

# ── Brevo (transactional email) ───────────────────────────────────────────────
BREVO_API_KEY=change-me
BREVO_SENDER_EMAIL=noreply@tobiira.io
BREVO_SENDER_NAME=Tobiira

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
# docker-compose / Railway: use service name → amqp://guest:guest@rabbitmq:5672
# local dev (no Docker): amqp://guest:guest@localhost:5672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://id.tobiira.io,https://persta.tobiira.io,https://testa.tobiira.io,https://lumi.tobiira.io,https://costa.tobiira.io

# ── Internal service-to-service ───────────────────────────────────────────────
INTERNAL_API_KEY=change-me-internal

# Service base URLs (used for internal HTTP calls between services)
# docker-compose / Railway: use service names (core, persta, payments)
# local dev (no Docker): use localhost
CORE_SERVICE_URL=http://core:6000
PERSTA_SERVICE_URL=http://persta:7000
PAYMENTS_SERVICE_URL=http://payments:6003

# ── Org invites ───────────────────────────────────────────────────────────────
INVITE_TTL_DAYS=7

# ── Cloudflare R2 (binary file uploads — IDs, contracts) ─────────────────────
# For MinIO/on-premise, set STORAGE_ENDPOINT instead of R2_ACCOUNT_ID
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=tobiira-documents
# STORAGE_ENDPOINT=http://localhost:9000
